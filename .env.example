# Usar exclusivamente um banco NOVO e vazio. Não usar valores do app original.
NODE_ENV=development
DATABASE_URL=mysql://ieqsede:local-password@127.0.0.1:3306/ieqsede
CORS_ORIGINS=http://localhost:8081
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
PORT=3000
# Antes de conectar banco remoto: conferir isolamento e definir explicitamente.
ALLOW_REMOTE_DATABASE=false
