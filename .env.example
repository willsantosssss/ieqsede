# Usar exclusivamente um banco NOVO e vazio. Não usar valores do app original.

NODE_ENV=development

DATABASE_URL=mysql://ieqsede:local-password@127.0.0.1:3306/ieqsede

CORS_ORIGINS=http://localhost:8081

EXPO_PUBLIC_API_BASE_URL=https://ieqsede-production.up.railway.app

PORT=3000

# Antes de conectar banco remoto: conferir isolamento e definir explicitamente.

ALLOW_REMOTE_DATABASE=false

# IPs/sub-redes de proxies confiáveis, após confirmar a topologia. Nunca usar true.

TRUSTED_PROXIES=

# No Railway, apontar para o caminho do volume persistente do serviço novo.

UPLOADS_DIR=uploads

